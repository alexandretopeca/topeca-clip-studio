config/private/
config/*secret*

# Personal hardware inventory; do not publish machine-specific details
/DIAGNOSTICO_HARDWARE_TOPECA.md

# User projects and generated output; retain only directory markers
/projects/*
!/projects/.gitkeep
/output/*
!/output/.gitkeep
/temp/*
!/temp/.gitkeep

# Recordings and personal audio/video
recordings/
gameplay/
captures/
personal_media/
*.mp4
*.m4v
*.mkv
*.mov
*.avi
*.wmv
*.webm
*.mpg
*.mpeg
*.m2ts
*.mts
